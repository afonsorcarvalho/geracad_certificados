<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Formato A4 retrato: certificado em uma única página.
       margin_top reserva o timbrado já impresso no papel (logo NetCom no topo).
       50mm = profundidade do timbrado medida com régua a partir da borda física
       do papel. Se a medida mudar, ajustar este campo E a altura de .folha
       abaixo (ver a nota de calibração lá). -->
  <record id="paperformat_certificado" model="report.paperformat">
    <field name="name">Certificado A4 Retrato</field>
    <field name="default" eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="dpi">100</field>
    <field name="margin_top">50</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">12</field>
    <field name="margin_right">12</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">0</field>
  </record>

  <!-- Template do certificado: página única, retrato -->
  <template id="report_certificado_template">
    <t t-call="web.html_container">
      <!-- Fonte e estilos emitidos uma única vez, fora do loop: em impressão em lote
           repetir por aluno faria N buscas remotas da fonte e inflaria o HTML. -->
        <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&amp;display=swap" rel="stylesheet"/>
        <style>
          /* Altura da folha: o bloco de assinaturas fica ancorado no pé desta tabela
             (td.pe é vertical-align: bottom), logo esta altura é o que fixa a distância
             das linhas de assinatura até a borda inferior do papel.
             ATENÇÃO: o wkhtmltopdf aplica um zoom ~0.766 sobre as unidades CSS neste
             paperformat, então o valor NÃO é a altura real em mm. Medido: 3.0167px/mm
             a 100dpi. Área imprimível = 297 - 50 (topo) - 8 (base) = 239mm = 942px;
             305mm * 3.0167 = 920px (310mm já transborda; 308mm é o maior valor
             testado que ainda cabe — 305mm deixa folga para variação de fontes).
             Se as margens do paperformat mudarem, recalibrar este valor. */
          .certificado { font-family: 'Libre Baskerville', Georgia, 'Times New Roman', serif; color: #1a1a1a; background: #fff; font-size: 11px; }
          .certificado .folha { width: 100%; height: 305mm; border-collapse: collapse; }
          .certificado .folha td { padding: 0; }
          .certificado .folha td.corpo { vertical-align: top; }
          .certificado .folha td.pe { vertical-align: bottom; height: 1px; }
          .certificado .titulo-principal { font-size: 28px; font-weight: bold; letter-spacing: 6px; margin: 0 0 4px; text-align: center; }
          .certificado .subtitulo { font-size: 10px; letter-spacing: 3px; color: #555; text-align: center; margin: 0 0 16px; text-transform: uppercase; }
          .certificado .dados { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
          .certificado .dados td { padding: 5px 0; vertical-align: bottom; font-size: 12px; }
          .certificado .dados td.rotulo { width: 110px; white-space: nowrap; padding-right: 8px; color: #1e3a5f; }
          .certificado .dados td.valor.destaque { font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; }
          .certificado .secao-titulo { font-size: 11px; font-weight: bold; text-decoration: underline; margin: 0 0 6px; }
          .certificado .conteudo-programatico { font-size: 9.5px; line-height: 1.35; text-align: justify; }
          .certificado .conteudo-programatico p { margin: 0 0 3px; }
          .certificado .conteudo-programatico ol, .certificado .conteudo-programatico ul { margin: 0 0 4px; padding-left: 20px; }
          .certificado .conteudo-programatico li { margin-bottom: 1px; }
          .certificado .rodape { width: 100%; border-collapse: collapse; margin-top: 12px; }
          .certificado .qr-verificacao { font-size: 8px; color: #666; text-align: center; line-height: 1.3; width: 110px; }
          .certificado .local-data { text-align: right; font-size: 12px; margin: 10px 0 22px; }
          .certificado .assinaturas { width: 100%; border-collapse: collapse; }
          .certificado .assinaturas td { width: 50%; vertical-align: bottom; text-align: center; padding: 0 10px; }
          .certificado .assinaturas.tres td { width: 33.33%; padding: 0 5px; }
          .certificado .assinaturas.tres p { font-size: 8px; }
          .certificado .assinaturas.tres p.nome { font-size: 9px; }
          .certificado .assinaturas.tres .caixa-assinatura img { max-width: 150px; }
          .certificado .caixa-assinatura { height: 60px; text-align: center; }
          .certificado .caixa-assinatura img { max-height: 60px; max-width: 200px; }
          .certificado .linha-assinatura { border: none; border-top: 1px solid #1a1a1a; margin: 0 0 4px; }
          /* Altura fixa do bloco sob a linha: garante que todas as linhas de
             assinatura fiquem na mesma altura (e à mesma distância do pé da
             página) independentemente de quantas qualificações cada signatário
             tenha. O overflow: hidden é o que sustenta esse alinhamento.
             Pior caso: instrutor == responsável técnico (2 colunas, fontes
             maiores), 7 linhas = ~68px reais. 34mm = ~102px reais, ou seja
             ~3 linhas de sobra para quando cargo_funcao quebrar em 2 linhas.
             Se algum signatário tiver qualificações muito longas e a última
             linha sumir, aumentar só este valor. */
          .certificado .abaixo-linha { height: 34mm; overflow: hidden; }
          .certificado .assinaturas p { margin: 0; font-size: 9px; line-height: 1.3; }
          .certificado .assinaturas p.nome { font-weight: bold; font-size: 10px; }
          .certificado .assinaturas p.papel { font-style: italic; color: #1e3a5f; margin-top: 2px; }
        </style>
      <t t-foreach="docs" t-as="o">
        <t t-set="company" t-value="o.env.company"/>
        <t t-set="curso" t-value="o.curso_id"/>
        <t t-set="mesmo_instrutor_resp"
           t-value="curso.instrutor_id and curso.responsavel_tecnico_id and curso.instrutor_id.id == curso.responsavel_tecnico_id.id"/>
        <div class="page certificado">

          <table class="folha">
            <tr><td class="corpo">

          <!-- Sem logo: o papel onde este certificado é impresso já é timbrado.
               O espaço do timbrado vem de margin_top no paperformat. -->
          <h1 class="titulo-principal">CERTIFICADO</h1>
          <p class="subtitulo">Treinamento / Capacitação</p>

          <!-- Bloco de dados -->
          <table class="dados">
            <tr>
              <td class="rotulo">Certificamos que</td>
              <td class="valor destaque"><t t-esc="o.nome_aluno"/></td>
            </tr>
            <tr>
              <td class="rotulo">Participou do</td>
              <td class="valor"><t t-esc="curso.name"/></td>
            </tr>
            <tr>
              <td class="rotulo">Realizado em</td>
              <td class="valor"><t t-esc="company.city or ''"/><t t-if="company.state_id"> - <t t-esc="company.state_id.code or company.state_id.name"/></t></td>
            </tr>
            <tr>
              <td class="rotulo">No período de</td>
              <td class="valor"><t t-esc="curso.get_periodo_display()"/></td>
            </tr>
            <tr>
              <td class="rotulo">Carga Horária</td>
              <td class="valor"><t t-esc="curso.carga_horaria"/> horas</td>
            </tr>
            <t t-if="o.aluno_categoria or o.aluno_registro or o.aluno_renach">
              <tr>
                <td class="rotulo">Participante</td>
                <td class="valor">
                  <t t-if="o.aluno_categoria">Cat.: <t t-esc="o.aluno_categoria"/> </t>
                  <t t-if="o.aluno_registro">Registro Nº: <t t-esc="o.aluno_registro"/> </t>
                  <t t-if="o.aluno_renach">RENACH: <t t-esc="o.aluno_renach"/></t>
                </td>
              </tr>
            </t>
          </table>

          <!-- Conteúdo programático (agora na mesma página) -->
          <p class="secao-titulo">Conteúdo Programático:</p>
          <div class="conteudo-programatico">
            <t t-if="curso.conteudo_programatico">
              <div t-field="curso.conteudo_programatico"/>
            </t>
            <t t-else="">
              <p><em>Conteúdo não informado.</em></p>
            </t>
          </div>

            </td></tr>
            <tr><td class="pe">

          <!-- Rodapé: QR de verificação (a caixa do livro de registro saiu: o
               papel timbrado já traz esses dados) -->
          <table class="rodape">
            <tr>
              <td class="qr-verificacao">
                <t t-set="qrb64" t-value="o.get_qrcode_base64()"/>
                <t t-if="qrb64">
                  <img t-att-src="'data:image/png;base64,' + qrb64" alt="QR" style="width: 84px; height: 84px; display: block; margin: 0 auto 3px;"/>
                  Verificação de autenticidade<br/>
                  <span style="word-break: break-all;"><t t-esc="o.token"/></span>
                </t>
              </td>
              <td></td>
            </tr>
          </table>

          <!-- Local e data -->
          <p class="local-data">
            <t t-esc="company.city or ''"/>, <t t-esc="curso.get_data_conclusao_display()"/>.
          </p>

          <!-- Assinaturas: participante à esquerda, instrutor/responsável à direita -->
          <table t-att-class="'assinaturas tres' if (not mesmo_instrutor_resp and curso.responsavel_tecnico_id) else 'assinaturas'">
            <tr>
              <td>
                <div class="caixa-assinatura"></div>
                <hr class="linha-assinatura"/>
                <div class="abaixo-linha">
                  <p class="nome"><t t-esc="o.nome_aluno"/></p>
                  <p class="papel">Participante</p>
                </div>
              </td>
              <t t-if="mesmo_instrutor_resp">
                <td>
                  <t t-set="img_unica" t-value="curso.assinatura_instrutor or curso.assinatura_responsavel_tecnico or (curso.instrutor_id and curso.instrutor_id.image_1920)"/>
                  <div class="caixa-assinatura">
                    <t t-if="img_unica">
                      <img t-att-src="image_data_uri(img_unica)" alt="Assinatura"/>
                    </t>
                  </div>
                  <hr class="linha-assinatura"/>
                  <div class="abaixo-linha">
                    <p class="nome"><t t-esc="curso.instrutor_id.name"/></p>
                    <t t-if="curso.instrutor_cargo_funcao"><p t-esc="curso.instrutor_cargo_funcao"/></t>
                    <t t-if="curso.instrutor_registro"><p>Registro Nº <t t-esc="curso.instrutor_registro"/></p></t>
                    <t t-if="curso.instrutor_renach"><p>RENACH: <t t-esc="curso.instrutor_renach"/></p></t>
                    <t t-if="curso.responsavel_tecnico_cargo_funcao"><p t-esc="curso.responsavel_tecnico_cargo_funcao"/></t>
                    <t t-if="curso.responsavel_tecnico_crea"><p>CREA: <t t-esc="curso.responsavel_tecnico_crea"/></p></t>
                    <p class="papel">Instrutor / Responsável Técnico</p>
                  </div>
                </td>
              </t>
              <t t-else="">
                <td>
                  <t t-set="img_instrutor" t-value="curso.assinatura_instrutor or (curso.instrutor_id and curso.instrutor_id.image_1920)"/>
                  <div class="caixa-assinatura">
                    <t t-if="img_instrutor">
                      <img t-att-src="image_data_uri(img_instrutor)" alt="Assinatura Instrutor"/>
                    </t>
                  </div>
                  <hr class="linha-assinatura"/>
                  <div class="abaixo-linha">
                    <p class="nome"><t t-esc="curso.instrutor_id.name"/></p>
                    <t t-if="curso.instrutor_cargo_funcao"><p t-esc="curso.instrutor_cargo_funcao"/></t>
                    <t t-if="curso.instrutor_registro"><p>Registro Nº <t t-esc="curso.instrutor_registro"/></p></t>
                    <t t-if="curso.instrutor_renach"><p>RENACH: <t t-esc="curso.instrutor_renach"/></p></t>
                    <p class="papel">Instrutor</p>
                  </div>
                </td>
                <td t-if="curso.responsavel_tecnico_id">
                  <t t-set="img_resp" t-value="curso.assinatura_responsavel_tecnico or (curso.responsavel_tecnico_id and curso.responsavel_tecnico_id.image_1920)"/>
                  <div class="caixa-assinatura">
                    <t t-if="img_resp">
                      <img t-att-src="image_data_uri(img_resp)" alt="Assinatura Responsável Técnico"/>
                    </t>
                  </div>
                  <hr class="linha-assinatura"/>
                  <div class="abaixo-linha">
                    <p class="nome"><t t-esc="curso.responsavel_tecnico_id.name"/></p>
                    <t t-if="curso.responsavel_tecnico_cargo_funcao"><p t-esc="curso.responsavel_tecnico_cargo_funcao"/></t>
                    <t t-if="curso.responsavel_tecnico_crea"><p>CREA: <t t-esc="curso.responsavel_tecnico_crea"/></p></t>
                    <p class="papel">Responsável Técnico</p>
                  </div>
                </td>
              </t>
            </tr>
          </table>

            </td></tr>
          </table>
        </div>
      </t>
    </t>
  </template>
</odoo>
